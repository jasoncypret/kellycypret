---
layout: layout.njk
showHomeHero: false
---
{#
  Coming-soon listing page — a trimmed sibling of listing-detail.njk.

  Used when the sign is in the ground but the photo shoot hasn't happened yet:
  one exterior photo, the address, the basic specs, and a way to reach Kelly.
  No price, no gallery, no reel, no 3D tour, no facts table.

  Shares the #lp token block and component styles with listing-detail.njk so
  the two pages look like the same site. Flip `page_template: full` in the
  listing's frontmatter once the real photos land.
#}
<style>
  /* ── Fix: main nav z-index on listing page ─────────────────────────────── */
  /* The global scrolled nav has z-index: 3 which is lower than our info card. */
  .ftco-navbar-light.scrolled { z-index: 200 !important; }

  /* ── Design tokens (shared with listing-detail.njk) ─────────────────────── */
  #lp { --lp-olive: #80745b; --lp-walnut: #5c4f3e; --lp-cream: #f2ede6;
    --lp-cream-dark: #e6ddcf; --lp-gold: #fff5c0; --lp-ink: #1a1a1a;
    --lp-coral: #e16262; --lp-gray-6: #666; --lp-gray-5: #8a8a8a;
    --lp-gray-2: #e8e2d9; --lp-border: rgba(0,0,0,.08);
    --lp-serif: "Sedan","Georgia",serif;
    --lp-sans: "Nunito Sans",-apple-system,sans-serif;
    --lp-pill: 100px; --lp-radius: 4px;
    --lp-shadow: 0 5px 21px -14px rgba(0,0,0,.14);
    --lp-shadow-hover: 0 5px 39px -14px rgba(0,0,0,.26);
    --lp-ease: .3s ease; }

  #lp * { box-sizing: border-box; }
  #lp img { display: block; max-width: 100%; }
  #lp a { text-decoration: none; }

  /* ── Helpers ── */
  #lp .lp-wrap  { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  #lp .lp-sec   { padding: 96px 0; }
  #lp .lp-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--lp-sans); font-size: 11px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    color: var(--lp-olive); margin: 0 0 14px;
  }
  #lp .lp-eyebrow::before { content: ""; width: 38px; height: 1px; background: currentColor; }
  #lp .lp-eyebrow.on-dark { color: var(--lp-gold); }
  #lp .lp-eyebrow.center  { justify-content: center; }
  #lp .lp-eyebrow.center::after { content: ""; width: 38px; height: 1px; background: currentColor; }
  #lp .lp-section-head { text-align: center; margin-bottom: 46px; }
  #lp .lp-h1 {
    font-family: var(--lp-serif); font-weight: 400; line-height: 1.15;
    color: rgba(0,0,0,.82); margin: 0; letter-spacing: -.01em;
  }
  #lp .lp-h2 {
    font-family: var(--lp-serif); font-size: 40px; font-weight: 700;
    line-height: 1.2; margin: 0; color: rgba(0,0,0,.82);
  }
  #lp .lp-h2.on-dark { color: #fff; }
  #lp .lp-desc { font-family: var(--lp-sans); font-size: 16px; line-height: 1.8; margin-top: 14px; margin-bottom: 0; color: var(--lp-gray-6); }

  /* ── Buttons ── */
  #lp .lp-btn {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 13px 28px; font-family: var(--lp-sans); font-size: 13px;
    font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    border-radius: var(--lp-pill); transition: all var(--lp-ease);
    white-space: nowrap; border: none; cursor: pointer;
  }
  #lp .lp-btn-olive  { background: var(--lp-olive); color: #fff; border: 1px solid var(--lp-olive); }
  #lp .lp-btn-olive:hover { background: #6b6049; color: #fff; }
  #lp .lp-btn-outline-olive { background: transparent; color: var(--lp-olive); border: 1px solid var(--lp-olive); }
  #lp .lp-btn-outline-olive:hover { background: var(--lp-olive); color: #fff; }
  #lp .lp-btn-cream  { background: var(--lp-cream); color: var(--lp-olive); border: 1px solid var(--lp-cream); }
  #lp .lp-btn-cream:hover { background: var(--lp-cream-dark); }
  #lp .lp-btn-outline-white { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,.8); }
  #lp .lp-btn-outline-white:hover { background: rgba(255,255,255,.12); color: #fff; }

  /* ── Hero (single still photo — no carousel until the shoot lands) ── */
  #lp .lp-hero {
    position: relative; isolation: isolate;
    height: min(85vh, 780px); min-height: 480px;
    background: var(--lp-ink); overflow: hidden;
  }
  #lp .lp-hero > img { width: 100%; height: 100%; object-fit: cover; }
  #lp .lp-hero-overlay {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    background: linear-gradient(180deg,
      rgba(20,18,13,.72) 0%,
      rgba(20,18,13,.42) 12%,
      rgba(20,18,13,.1)  28%,
      rgba(20,18,13,0)   46%,
      rgba(20,18,13,.1)  100%);
  }

  /* ── Info card ──
     With no gallery section following, this block carries the whole top of the
     page, so it runs roomier than its listing-detail.njk counterpart and the
     section below it holds a wide gap before the closing CTA.               */
  #lp .lp-hero-block { padding-bottom: clamp(80px, 10vw, 140px); }
  #lp .lp-info-card {
    background: #fff; box-shadow: var(--lp-shadow-hover);
    padding: 46px 48px; display: flex; flex-wrap: wrap; gap: 40px;
    align-items: center; justify-content: space-between;
    margin-top: -78px; position: relative; z-index: 10;
  }
  #lp .lp-info-left  { flex: 1 1 340px; min-width: 280px; }
  #lp .lp-info-right { flex: 0 0 auto; text-align: right; min-width: 240px; }
  #lp .lp-spec-row   { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  #lp .lp-spec-pill  { display: inline-flex; align-items: center; gap: 9px; font-size: 15.5px; color: rgba(0,0,0,.82); font-family: var(--lp-sans); }
  #lp .lp-spec-pill .fa { color: var(--lp-olive); font-size: 15px; }
  #lp .lp-spec-pill strong { font-weight: 700; }
  #lp .lp-spec-div   { width: 1px; height: 22px; background: var(--lp-gray-2); }
  #lp .lp-btn-row    { display: flex; gap: 10px; flex-wrap: wrap; }
  #lp .lp-tagline    { text-align: center; margin: 38px auto 0; max-width: 720px; font-family: var(--lp-sans); font-size: 17.5px; line-height: 1.7; color: var(--lp-gray-6); }

  /* Stands in for the price block on the full template */
  #lp .lp-pending-note {
    font-family: var(--lp-sans); font-size: 14.5px; line-height: 1.6;
    color: var(--lp-gray-5); margin: 0 0 18px; max-width: 330px;
    display: inline-block; text-align: right; text-wrap: balance;
  }
  #lp .lp-pending-note strong {
    display: block; margin-bottom: 2px;
    font-family: var(--lp-serif); font-size: 26px; font-weight: 400;
    line-height: 1.2; color: var(--lp-walnut);
  }

  /* ── Agent CTA ── */
  #lp .lp-agent-grid { display: grid; grid-template-columns: auto 1fr; gap: 56px; align-items: center; }
  #lp .lp-agent-photo { width: 220px; height: 270px; object-fit: cover; object-position: top center; box-shadow: 0 24px 60px -20px rgba(0,0,0,.6); }

  /* ── Mobile call bar ── */
  .lp-call-bar { display: none; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    #lp .lp-sec { padding: 64px 0; }
    #lp .lp-agent-grid { grid-template-columns: 1fr; gap: 32px; text-align: center; }
    #lp .lp-info-card  { padding: 24px 20px; }
    #lp .lp-info-right { text-align: left; min-width: unset; width: 100%; }
    #lp .lp-pending-note { text-align: left; max-width: none; }
    #lp .lp-btn-row    { justify-content: flex-start; }
  }
  @media (max-width: 620px) {
    .lp-call-bar {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 80;
      gap: 10px; padding: 11px 14px calc(11px + env(safe-area-inset-bottom));
      background: rgba(255,255,255,.96); backdrop-filter: blur(10px);
      border-top: 1px solid rgba(0,0,0,.08);
    }
    .lp-call-bar a {
      flex: 1; text-align: center; padding: 14px; border-radius: 100px;
      font-family: var(--lp-sans); font-size: 13px; font-weight: 700;
      letter-spacing: 1px; text-transform: uppercase;
    }
    .lp-call-bar .cb-call { background: #80745b; color: #fff; }
    .lp-call-bar .cb-text { background: #f2ede6; color: #80745b; border: 1px solid #e6ddcf; }
    body { padding-bottom: 74px; }
  }
</style>

<div id="lp">

<!-- ══════════ HERO ══════════ -->
<section id="top" class="lp-hero-block">
  <div class="lp-hero">
    <img src="{{ hero_image }}" alt="{{ address }}, {{ city }}, {{ state }}" loading="eager">
    <div class="lp-hero-overlay"></div>
  </div>

  <!-- Info card overlaps the bottom of the hero -->
  <div class="lp-wrap">
    <div class="lp-info-card">
      <div class="lp-info-left">
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:4px;flex-wrap:wrap;">
          {# Eyebrow deliberately does NOT repeat the badge text next to it #}
          <span class="lp-eyebrow" style="margin:0;">{{ eyebrow_label or "New Listing" }} · {{ city }}</span>
          <span style="display:inline-flex;align-items:center;font-family:var(--lp-sans);font-size:11px;font-weight:700;letter-spacing:.06em;text-transform:uppercase;padding:4px 11px;border-radius:4px;background:var(--lp-coral);color:#fff;">{{ status_badge or "Coming Soon" }}</span>
        </div>
        <h1 class="lp-h1" style="font-size: clamp(28px,4vw,44px); margin-bottom: 6px;">{{ address }}</h1>
        <p style="font-family:var(--lp-sans);font-size:17px;color:var(--lp-gray-5);margin:0 0 18px;">{{ city }}, {{ state }}{% if zip %} {{ zip }}{% endif %}</p>
        <div class="lp-spec-row">
          {% if beds %}<span class="lp-spec-pill"><span class="fa fa-bed"></span><strong>{{ beds }} Beds</strong></span>{% endif %}
          {% if baths %}<span class="lp-spec-div"></span>
          <span class="lp-spec-pill"><span class="fa fa-bath"></span><strong>{{ baths }} Baths</strong></span>{% endif %}
          {% if sqft %}<span class="lp-spec-div"></span>
          <span class="lp-spec-pill"><span class="fa fa-arrows-alt"></span><strong>{{ sqft }} Sq Ft</strong></span>{% endif %}
          {% if lot %}<span class="lp-spec-div"></span>
          <span class="lp-spec-pill"><span class="fa fa-tree"></span><strong>{{ lot }} Acre</strong></span>{% endif %}
          {% if year_built %}<span class="lp-spec-div"></span>
          <span class="lp-spec-pill"><span class="fa fa-home"></span><strong>Built {{ year_built }}</strong></span>{% endif %}
        </div>
      </div>
      <div class="lp-info-right">
        <p class="lp-pending-note">
          <strong>Coming soon</strong>
          Photos, video &amp; full details are on the way.
        </p>
        <div class="lp-btn-row" style="justify-content:flex-end;">
          <a class="lp-btn lp-btn-olive" href="tel:{{ phone_dial }}"><span class="fa fa-phone"></span> Call Kelly</a>
          <a class="lp-btn lp-btn-outline-olive" href="sms:{{ phone_dial }}"><span class="fa fa-commenting-o"></span> Text</a>
        </div>
      </div>
    </div>
    {% if tagline %}<p class="lp-tagline">{{ tagline }}</p>{% endif %}
  </div>
</section>

<!-- ══════════ AGENT CTA ══════════
     Deliberately the only closing section — with no gallery to break things up,
     a second "get in touch" band above this one just said the same thing twice. -->

<section style="background:var(--lp-ink,#1a1a1a);">
  <div class="lp-wrap" style="padding:90px 24px;">
    <div class="lp-agent-grid">
      <div>
        <img class="lp-agent-photo" src="/assets/images/Kelly-Large.webp" alt="Kelly Cypret, Realtor">
      </div>
      <div>
        <span class="lp-eyebrow on-dark">Your Agent</span>
        <h2 class="lp-h2 on-dark" style="font-size:38px;margin-bottom:14px;">{{ agent_title or "Let's Walk It Together" }}</h2>
        {% if agent_desc %}
        <p style="font-family:var(--lp-sans);font-size:17px;line-height:1.75;color:rgba(255,255,255,.78);max-width:560px;margin:0 0 26px;">
          {{ agent_desc }}
        </p>
        {% endif %}
        <div class="lp-btn-row" style="margin-bottom:24px;">
          <a class="lp-btn lp-btn-cream" href="tel:{{ phone_dial }}"><span class="fa fa-phone"></span> Call {{ phone_display }}</a>
          <a class="lp-btn lp-btn-outline-white" href="sms:{{ phone_dial }}"><span class="fa fa-commenting-o"></span> Text Kelly</a>
          <a class="lp-btn lp-btn-outline-white" href="mailto:{{ email }}"><span class="fa fa-envelope"></span> Email</a>
        </div>
        <div style="font-family:var(--lp-sans);font-size:14.5px;color:rgba(255,255,255,.6);">
          Kelly Cypret, Realtor® · Nolen Rodgers Realty
        </div>
      </div>
    </div>
  </div>
</section>

</div>{# end #lp #}

<!-- ══════════ MOBILE CALL BAR ══════════ -->
<div class="lp-call-bar">
  <a class="cb-call" href="tel:{{ phone_dial }}"><span class="fa fa-phone"></span> Call</a>
  <a class="cb-text" href="sms:{{ phone_dial }}">Text Kelly</a>
</div>
