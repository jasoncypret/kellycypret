---
layout: layout.njk
showHomeHero: false
---
<style>
  /* ── Fix: main nav z-index on listing page ─────────────────────────────── */
  /* The global scrolled nav has z-index: 3 which is lower than our info card. */
  /* Override it here so the fixed nav always sits above page content.         */
  .ftco-navbar-light.scrolled { z-index: 200 !important; }

  /* ── Design tokens ──────────────────────────────────────────────────────── */
  #lp { --lp-olive: #80745b; --lp-walnut: #5c4f3e; --lp-cream: #f2ede6;
    --lp-cream-dark: #e6ddcf; --lp-gold: #fff5c0; --lp-ink: #1a1a1a;
    --lp-coral: #e16262; --lp-gray-6: #666; --lp-gray-5: #8a8a8a;
    --lp-gray-2: #e8e2d9; --lp-border: rgba(0,0,0,.08);
    --lp-serif: "Sedan","Georgia",serif;
    --lp-sans: "Nunito Sans",-apple-system,sans-serif;
    --lp-pill: 100px; --lp-radius: 4px;
    --lp-shadow: 0 5px 21px -14px rgba(0,0,0,.14);
    --lp-shadow-hover: 0 5px 39px -14px rgba(0,0,0,.26);
    --lp-ease: .3s ease; }

  #lp * { box-sizing: border-box; }
  #lp img { display: block; max-width: 100%; }
  #lp a { text-decoration: none; }

  /* ── Sub-nav ─────────────────────────────────────────────────────────────
     Starts transparent (glass) overlaying the hero — same pattern as the
     main nav. Turns solid once the hero scrolls away (JS adds --solid class).
     JS also sets --subnav-top so it always sits flush below the main nav.   */
  .lp-subnav {
    position: fixed;
    top: var(--subnav-top, 0px);
    left: 0; right: 0;
    z-index: 90;
    display: flex; align-items: center;
    padding: 0 26px; height: 48px;
    background: transparent;
    border-bottom: none;
    font-family: var(--lp-sans);
    transition: background .35s ease, border-color .35s ease;
  }
  /* Solid state: triggered by JS when hero scrolls out of view */
  .lp-subnav.lp-nav-solid {
    background: rgba(255,255,255,.97);
    backdrop-filter: blur(10px);
    border-bottom-color: rgba(0,0,0,.08);
  }
  /* Center the section links; push the CTA to the right edge */
  .lp-subnav-links {
    flex: 1; display: flex; justify-content: center; gap: 28px;
  }
  .lp-subnav-links a {
    font-size: 12px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase;
    color: rgba(255,255,255,.9); transition: color var(--lp-ease);
  }
  .lp-subnav.lp-nav-solid .lp-subnav-links a { color: var(--lp-ink); }
  .lp-subnav-links a:hover { color: #fff; }
  .lp-subnav.lp-nav-solid .lp-subnav-links a:hover { color: var(--lp-olive); }
  .lp-subnav-cta {
    flex: none;
    display: inline-flex; align-items: center; gap: 7px;
    padding: 7px 18px; font-size: 11px; font-weight: 700;
    letter-spacing: .06em; text-transform: uppercase;
    background: rgba(255,255,255,.2); color: #fff;
    border: 1px solid rgba(255,255,255,.55);
    border-radius: var(--lp-pill); transition: all var(--lp-ease);
  }
  .lp-subnav.lp-nav-solid .lp-subnav-cta { background: var(--lp-olive); border-color: var(--lp-olive); }
  .lp-subnav-cta:hover { background: rgba(255,255,255,.35); color: #fff; }
  .lp-subnav.lp-nav-solid .lp-subnav-cta:hover { background: #6b6049; }

  /* ── Helpers ── */
  #lp .lp-wrap  { width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 24px; }
  #lp .lp-wide  { width: 100%; max-width: 1320px; margin: 0 auto; padding: 0 24px; }
  #lp .lp-sec   { padding: 96px 0; }
  #lp .lp-eyebrow {
    display: inline-flex; align-items: center; gap: 12px;
    font-family: var(--lp-sans); font-size: 11px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase;
    color: var(--lp-olive); margin: 0 0 14px;
  }
  #lp .lp-eyebrow::before { content: ""; width: 38px; height: 1px; background: currentColor; }
  #lp .lp-eyebrow.on-dark { color: var(--lp-gold); }
  #lp .lp-eyebrow.center  { justify-content: center; }
  #lp .lp-eyebrow.center::after { content: ""; width: 38px; height: 1px; background: currentColor; }
  #lp .lp-section-head { text-align: center; margin-bottom: 46px; }
  #lp .lp-h1 {
    font-family: var(--lp-serif); font-weight: 400; line-height: 1.15;
    color: rgba(0,0,0,.82); margin: 0; letter-spacing: -.01em;
  }
  #lp .lp-h2 {
    font-family: var(--lp-serif); font-size: 40px; font-weight: 700;
    line-height: 1.2; margin: 0; color: rgba(0,0,0,.82);
  }
  #lp .lp-h2.on-dark { color: #fff; }
  #lp .lp-desc { font-family: var(--lp-sans); font-size: 16px; line-height: 1.8; margin-top: 14px; margin-bottom: 0; color: var(--lp-gray-6); }
  #lp .lp-desc.on-dark { color: rgba(255,255,255,.78); }

  /* ── Buttons ── */
  #lp .lp-btn {
    display: inline-flex; align-items: center; gap: 9px;
    padding: 13px 28px; font-family: var(--lp-sans); font-size: 13px;
    font-weight: 700; letter-spacing: 1px; text-transform: uppercase;
    border-radius: var(--lp-pill); transition: all var(--lp-ease);
    white-space: nowrap; border: none; cursor: pointer;
  }
  #lp .lp-btn-olive  { background: var(--lp-olive); color: #fff; border: 1px solid var(--lp-olive); }
  #lp .lp-btn-olive:hover { background: #6b6049; color: #fff; }
  #lp .lp-btn-outline-olive { background: transparent; color: var(--lp-olive); border: 1px solid var(--lp-olive); }
  #lp .lp-btn-outline-olive:hover { background: var(--lp-olive); color: #fff; }
  #lp .lp-btn-cream  { background: var(--lp-cream); color: var(--lp-olive); border: 1px solid var(--lp-cream); }
  #lp .lp-btn-cream:hover { background: var(--lp-cream-dark); }
  #lp .lp-btn-outline-white { background: transparent; color: #fff; border: 1px solid rgba(255,255,255,.8); }
  #lp .lp-btn-outline-white:hover { background: rgba(255,255,255,.12); color: #fff; }

  /* ── Hero carousel ── */
  #lp .lp-hero {
    position: relative;
    /* isolation: isolate creates a stacking context so the overlay's z-index
       only competes with slides inside the hero, not with the main nav above. */
    isolation: isolate;
    height: min(85vh, 780px); min-height: 480px;
    background: var(--lp-ink); overflow: hidden;
  }
  #lp .lp-slide {
    position: absolute; inset: 0; opacity: 0; z-index: 1;
    transition: opacity 1.4s ease;
  }
  #lp .lp-slide.is-active { opacity: 1; z-index: 2; }

  /* Photo slides */
  #lp .lp-slide img {
    width: 100%; height: 100%; object-fit: cover;
    transform: scale(1);
    opacity: 0; transition: opacity .6s ease, transform 8s ease;
  }
  #lp .lp-slide img.img-loaded { opacity: 1; }
  #lp .lp-slide.is-active img { transform: scale(1.06); }

  /* Video slide — portrait 9:16 iframe scaled to cover landscape container */
  #lp .lp-slide-video iframe {
    position: absolute;
    /* Scale a 9:16 portrait video to fill a 16:9 landscape container:
       iframe_height = container_height × (16/9)² ≈ 316%             */
    width: 100%;
    height: 316%;
    top: 50%; left: 0;
    transform: translateY(-50%);
    border: 0;
    pointer-events: none;
  }

  #lp .lp-hero-overlay {
    position: absolute; inset: 0; z-index: 3; pointer-events: none;
    /* Stronger gradient at top so the white main-nav logo stays readable
       on light-sky hero photos; fades to nothing in the middle.           */
    background: linear-gradient(180deg,
      rgba(20,18,13,.72) 0%,
      rgba(20,18,13,.42) 12%,
      rgba(20,18,13,.1)  28%,
      rgba(20,18,13,0)   46%,
      rgba(20,18,13,.1)  100%);
  }
  #lp .lp-carousel-dots {
    position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%);
    z-index: 4; display: flex; gap: 7px; align-items: center;
  }
  #lp .lp-dot {
    width: 8px; height: 8px; border-radius: 4px; padding: 0; cursor: pointer;
    border: 1.5px solid rgba(255,255,255,.65); background: transparent;
    transition: all .35s ease;
  }
  #lp .lp-dot.is-active { width: 26px; background: #fff; border-color: #fff; }

  /* ── Info card (z-index below main nav z-index 200) ── */
  #lp .lp-info-card {
    background: #fff; box-shadow: var(--lp-shadow-hover);
    padding: 34px 40px; display: flex; flex-wrap: wrap; gap: 28px;
    align-items: center; justify-content: space-between;
    margin-top: -78px; position: relative; z-index: 10;
  }
  #lp .lp-info-left  { flex: 1 1 340px; min-width: 280px; }
  #lp .lp-info-right { flex: 0 0 auto; text-align: right; min-width: 240px; }
  #lp .lp-spec-row   { display: flex; flex-wrap: wrap; gap: 16px; align-items: center; }
  #lp .lp-spec-pill  { display: inline-flex; align-items: center; gap: 9px; font-size: 15.5px; color: rgba(0,0,0,.82); font-family: var(--lp-sans); }
  #lp .lp-spec-pill .fa { color: var(--lp-olive); font-size: 15px; }
  #lp .lp-spec-pill strong { font-weight: 700; }
  #lp .lp-spec-div   { width: 1px; height: 22px; background: var(--lp-gray-2); }
  #lp .lp-price      { font-family: var(--lp-serif); font-size: 46px; line-height: 1; color: var(--lp-walnut); }
  #lp .lp-price-meta { font-family: var(--lp-sans); font-size: 13.5px; color: var(--lp-gray-5); margin: 8px 0 18px; }
  #lp .lp-btn-row    { display: flex; gap: 10px; flex-wrap: wrap; }
  #lp .lp-tagline    { text-align: center; margin: 22px auto 0; max-width: 720px; font-family: var(--lp-sans); font-size: 16.5px; color: var(--lp-gray-6); }

  /* ── Gallery ── */
  #lp .lp-gallery-grid {
    display: grid; grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 200px; gap: 14px;
  }
  #lp .lp-gal-cell   { position: relative; overflow: hidden; cursor: pointer; }
  #lp .lp-gal-cell img { width: 100%; height: 100%; object-fit: cover; transition: transform .5s ease; }
  #lp .lp-gal-cell:hover img { transform: scale(1.05); }
  #lp .lp-gal-cell.tall { grid-row: span 2; }
  #lp .lp-gal-cell.wide { grid-column: span 2; }
  #lp .lp-gal-caption {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 3;
    padding: 30px 16px 13px; pointer-events: none;
    font-family: var(--lp-sans); font-size: 12.5px; font-weight: 600;
    letter-spacing: .04em; color: #fff;
    background: linear-gradient(transparent,rgba(20,18,15,.62));
    opacity: 0; transition: opacity .3s ease;
  }
  #lp .lp-gal-cell:hover .lp-gal-caption { opacity: 1; }
  #lp .lp-gal-expand {
    position: absolute; top: 10px; right: 10px; z-index: 4;
    width: 38px; height: 38px; border: none; cursor: pointer;
    border-radius: 50%; background: rgba(26,26,26,.55); color: #fff;
    display: flex; align-items: center; justify-content: center;
    opacity: 0; transition: opacity .25s ease, background .25s ease;
    backdrop-filter: blur(4px);
  }
  #lp .lp-gal-cell:hover .lp-gal-expand { opacity: 1; }
  #lp .lp-gal-expand:hover { background: var(--lp-coral); }
  #lp .lp-gallery-hint { text-align: center; margin-top: 22px; font-family: var(--lp-sans); font-size: 13.5px; color: var(--lp-gray-5); }
  #lp .lp-gallery-hint a { color: var(--lp-olive); }

  /* ── Reel (split dark section) ── */
  #lp .lp-reel        { background: #14120d; overflow: hidden; }
  #lp .lp-reel-split  { display: grid; grid-template-columns: 1fr auto; min-height: 100svh; align-items: stretch; }
  #lp .lp-reel-text   {
    display: flex; flex-direction: column; justify-content: center;
    padding: 80px clamp(32px,5vw,72px); max-width: 580px; margin: 0 auto; width: 100%;
  }
  #lp .lp-reel-video  { display: flex; align-items: stretch; background: #0c0b09; }
  #lp .lp-reel-portrait {
    height: 100%; min-height: min(100svh,900px);
    aspect-ratio: 9/16; position: relative; overflow: hidden;
    box-shadow: -20px 0 60px rgba(0,0,0,.55);
  }
  #lp .lp-reel-portrait iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  #lp .lp-reel-feature-list { list-style: none; margin: 0 0 40px; padding: 0; display: grid; gap: 14px; }
  #lp .lp-reel-feature {
    display: flex; gap: 14px; align-items: center;
    color: rgba(255,255,255,.85); font-family: var(--lp-sans); font-size: 15.5px;
  }
  #lp .lp-reel-icon {
    flex: none; width: 36px; height: 36px; border-radius: 50%;
    background: rgba(255,255,255,.1); border: 1px solid rgba(255,255,255,.14);
    display: flex; align-items: center; justify-content: center;
  }
  #lp .lp-reel-icon .fa { color: var(--lp-gold); font-size: 13px; }

  /* ── 3D tour ── */
  #lp .lp-tour-frame {
    position: relative; width: 100%; aspect-ratio: 16/9;
    border-radius: 4px; overflow: hidden;
    box-shadow: 0 30px 70px -34px rgba(0,0,0,.45);
    background: #ded7cc;
  }
  #lp .lp-tour-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }

  /* ── About ── */
  #lp .lp-about-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 64px; align-items: start; }
  #lp .lp-about-text p { font-family: var(--lp-sans); font-size: 16.5px; line-height: 1.85; margin: 0 0 18px; color: var(--lp-gray-6); }
  #lp .lp-highlights-box { background: var(--lp-cream); padding: 36px 34px; }
  #lp .lp-highlights-box h3 { font-family: var(--lp-serif); font-size: 22px; font-weight: 400; margin: 0 0 22px; color: rgba(0,0,0,.82); }
  #lp .lp-hl-list { list-style: none; margin: 0; padding: 0; display: grid; gap: 16px; }
  #lp .lp-hl-item { display: flex; align-items: center; gap: 14px; font-family: var(--lp-sans); font-size: 15.5px; color: rgba(0,0,0,.82); }
  #lp .lp-hl-icon {
    flex: none; width: 38px; height: 38px; border-radius: 50%;
    background: #fff; display: flex; align-items: center; justify-content: center;
    color: var(--lp-olive); box-shadow: var(--lp-shadow);
  }

  /* ── Facts ── */
  #lp .lp-facts-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 46px; }
  #lp .lp-fact-group h4 {
    font-family: var(--lp-sans); font-size: 12px; font-weight: 700;
    letter-spacing: 2px; text-transform: uppercase; color: var(--lp-olive);
    margin: 0 0 14px; padding-bottom: 12px; border-bottom: 1px solid var(--lp-gray-2);
  }
  #lp .lp-fact-group dl { margin: 0; }
  #lp .lp-fact-row {
    display: flex; justify-content: space-between; gap: 16px;
    padding: 9px 0; border-bottom: 1px solid var(--lp-border);
    font-family: var(--lp-sans); font-size: 14.5px;
  }
  #lp .lp-fact-row dt { color: var(--lp-gray-5); }
  #lp .lp-fact-row dd { margin: 0; color: rgba(0,0,0,.82); font-weight: 600; text-align: right; }

  /* ── Agent CTA ── */
  #lp .lp-agent-grid { display: grid; grid-template-columns: auto 1fr; gap: 56px; align-items: center; }
  #lp .lp-agent-photo { width: 220px; height: 270px; object-fit: cover; object-position: top center; box-shadow: 0 24px 60px -20px rgba(0,0,0,.6); }

  /* ── Lightbox ── */
  #lp-lightbox {
    position: fixed; inset: 0; z-index: 9999;
    background: rgba(20,18,15,.94);
    display: none; align-items: center; justify-content: center;
  }
  #lp-lightbox.open { display: flex; }
  #lp-lightbox img  { max-width: 90vw; max-height: 86vh; box-shadow: 0 30px 80px rgba(0,0,0,.5); }
  .lp-lb-btn {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 56px; height: 56px; border: none; cursor: pointer;
    background: transparent; color: rgba(255,255,255,.8); font-size: 30px;
  }
  .lp-lb-btn:hover { color: #fff; }
  .lp-lb-prev { left: 18px; } .lp-lb-next { right: 18px; }
  #lp-lb-close {
    position: absolute; top: 22px; right: 26px; width: 46px; height: 46px;
    border: none; cursor: pointer; background: transparent;
    color: rgba(255,255,255,.8); font-size: 26px;
  }
  #lp-lb-close:hover { color: #fff; }
  #lp-lb-counter {
    position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%);
    color: rgba(255,255,255,.6); font-size: 13px; font-family: var(--lp-sans);
  }

  /* Anchor links land below both fixed bars (main nav ~110px + sub-nav 48px) */
  #lp-gallery, #lp-reel, #lp-tour, #lp-about, #lp-facts {
    scroll-margin-top: calc(var(--subnav-top, 0px) + 58px);
  }

  /* ── Mobile call bar ── */
  .lp-call-bar { display: none; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    #lp .lp-facts-grid { grid-template-columns: 1fr; gap: 30px; }
    #lp .lp-gallery-grid { grid-template-columns: repeat(2,1fr); grid-auto-rows: 150px; }
    #lp .lp-sec { padding: 64px 0; }
    #lp .lp-about-grid { grid-template-columns: 1fr; gap: 36px; }
    #lp .lp-agent-grid { grid-template-columns: 1fr; gap: 32px; text-align: center; }
    .lp-subnav-links { gap: 16px; }
    #lp .lp-reel-split { grid-template-columns: 1fr; min-height: auto; }
    #lp .lp-reel-text  { max-width: 100%; padding: 56px 24px 40px; }
    #lp .lp-reel-video { justify-content: center; padding: 0 24px 56px; }
    #lp .lp-reel-portrait { height: auto; min-height: unset; width: min(80vw,340px); aspect-ratio: 9/16; }
    #lp .lp-info-card  { padding: 24px 20px; }
    #lp .lp-price      { font-size: 34px; }
    #lp .lp-info-right { text-align: left; min-width: unset; width: 100%; }
    #lp .lp-btn-row    { justify-content: flex-start; }
  }
  @media (max-width: 620px) {
    #lp .lp-gallery-grid { grid-template-columns: 1fr 1fr; grid-auto-rows: 120px; }
    .lp-subnav { display: none; }
    .lp-call-bar {
      display: flex; position: fixed; left: 0; right: 0; bottom: 0; z-index: 80;
      gap: 10px; padding: 11px 14px calc(11px + env(safe-area-inset-bottom));
      background: rgba(255,255,255,.96); backdrop-filter: blur(10px);
      border-top: 1px solid rgba(0,0,0,.08);
    }
    .lp-call-bar a {
      flex: 1; text-align: center; padding: 14px; border-radius: 100px;
      font-family: var(--lp-sans); font-size: 13px; font-weight: 700;
      letter-spacing: 1px; text-transform: uppercase;
    }
    .lp-call-bar .cb-call { background: #80745b; color: #fff; }
    .lp-call-bar .cb-text { background: #f2ede6; color: #80745b; border: 1px solid #e6ddcf; }
    body { padding-bottom: 74px; }
  }
</style>

<div id="lp">

<!-- ══════════ SUB-NAV (fixed, always visible below the main nav) ══════════
     position:fixed so it appears immediately at the top regardless of scroll.
     JS measures the main nav and sets --subnav-top.                         -->
<div class="lp-subnav" id="lp-subnav">
  <div class="lp-subnav-links">
    <a href="#lp-gallery">Gallery</a>
    <a href="#lp-reel">Walkthrough</a>
    <a href="#lp-tour">3D Tour</a>
    <a href="#lp-about">About</a>
    <a href="#lp-facts">Details</a>
  </div>
  <a class="lp-subnav-cta" href="tel:{{ phone_dial }}">
    <span class="fa fa-phone"></span> Call Kelly
  </a>
</div>

<!-- ══════════ HERO CAROUSEL ══════════
     position:absolute main nav + position:fixed sub-nav both float over the
     hero. Hero fills the viewport from the very top.                        -->
<section id="top">
  <div class="lp-hero" id="lp-hero">
    <!-- Photo slides -->
    {% for slide in hero_slides %}
    <div class="lp-slide{% if loop.first %} is-active{% endif %}" data-index="{{ loop.index0 }}">
      <img src="{{ slide.src }}"
           alt="{{ address }} — photo {{ loop.index }}"
           style="object-position: {{ slide.pos }};"
           {% if loop.first %}loading="eager"{% else %}loading="lazy"{% endif %}>
    </div>
    {% endfor %}
    <!-- Video slide: src swapped in/out by carousel JS for reliable autoplay.
         loop=1 + playlist param prevents the YouTube replay button showing.  -->
    {% if video_id %}
    <div class="lp-slide lp-slide-video" data-index="{{ hero_slides | length }}"
         data-video-src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&mute=1&controls=0&loop=1&playlist={{ video_id }}&playsinline=1&rel=0&modestbranding=1">
      <iframe
        title="Video walkthrough — {{ address }}"
        allow="autoplay; encrypted-media"
        allowfullscreen></iframe>
    </div>
    {% endif %}

    <div class="lp-hero-overlay"></div>
    <div class="lp-carousel-dots" id="lp-dots">
      {% for slide in hero_slides %}
      <button class="lp-dot{% if loop.first %} is-active{% endif %}"
              data-index="{{ loop.index0 }}"
              aria-label="Go to photo {{ loop.index }}"></button>
      {% endfor %}
      {% if video_id %}
      <button class="lp-dot" data-index="{{ hero_slides | length }}" aria-label="Video slide"></button>
      {% endif %}
    </div>
  </div>

  <!-- Info card overlaps the bottom of the hero -->
  <div class="lp-wrap">
    <div class="lp-info-card">
      <div class="lp-info-left">
        {# Closed listings stay published as a portfolio piece — the eyebrow and
           badge shift to a muted "Sold" so they don't read as a live listing. #}
        {% set isSold = status == 'sold' %}
        {% if isSold %}{% set statusLabel = "Sold" %}
        {% elif status == 'pending' %}{% set statusLabel = "Pending" %}
        {% else %}{% set statusLabel = "For Sale" %}{% endif %}
        <div style="display:flex;align-items:center;gap:12px;margin-bottom:4px;flex-wrap:wrap;">
          <span class="lp-eyebrow" style="margin:0;">{{ statusLabel }} · {{ city }}</span>
          {% if status_badge %}
