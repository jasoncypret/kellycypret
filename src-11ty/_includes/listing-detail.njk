  <button class="lp-lb-btn lp-lb-prev" id="lp-lb-prev" aria-label="Previous">&#8249;</button>
  <img id="lp-lb-img" alt="Listing photo">
  <button class="lp-lb-btn lp-lb-next" id="lp-lb-next" aria-label="Next">&#8250;</button>
  <div id="lp-lb-counter"></div>
</div>

<!-- ══════════ MOBILE CALL BAR ══════════ -->
<div class="lp-call-bar">
  <a class="cb-call" href="tel:{{ phone_dial }}"><span class="fa fa-phone"></span> Call</a>
  <a class="cb-text" href="sms:{{ phone_dial }}">Text Kelly</a>
</div>

<script>
(function () {

  /* ── Sub-nav: position below main nav + transparent→solid on scroll ── */
  var mainNav = document.getElementById('ftco-navbar');
  var subnav  = document.getElementById('lp-subnav');
  var hero    = document.getElementById('lp-hero');

  function syncSubnav() {
    if (!mainNav || !subnav) return;
    /* Keep sub-nav flush below main nav at all times */
    subnav.style.setProperty('--subnav-top', mainNav.offsetHeight + 'px');
    /* Turn solid once the hero has scrolled mostly past */
    var threshold = hero ? hero.offsetHeight * 0.8 : 400;
    subnav.classList.toggle('lp-nav-solid', window.scrollY > threshold);
  }

  syncSubnav();
  window.addEventListener('resize', syncSubnav);
  document.addEventListener('scroll', syncSubnav, { passive: true });

  /* ── Carousel ── */
  var slides  = document.querySelectorAll('#lp-hero .lp-slide');
  var dots    = document.querySelectorAll('#lp-dots .lp-dot');
  var current = 0;
  var timer;
  /* Longer dwell on the video slide so people get a real preview */
  var DURATIONS = [];
  slides.forEach(function (s, i) {
    DURATIONS[i] = s.classList.contains('lp-slide-video') ? 9000 : 5200;
  });

  /* Image fade-in on load */
  slides.forEach(function (slide) {
    var img = slide.querySelector('img');
    if (!img) return;
    function markLoaded() { img.classList.add('img-loaded'); }
    if (img.complete) markLoaded();
    else img.addEventListener('load', markLoaded);
  });

  function goTo(n) {
    /* Unload video if leaving a video slide (stops playback, clears replay UI) */
    var leaving = slides[current];
    if (leaving.classList.contains('lp-slide-video')) {
      var leavingIframe = leaving.querySelector('iframe');
      if (leavingIframe) leavingIframe.src = '';
    }

    leaving.classList.remove('is-active');
    dots[current].classList.remove('is-active');
    current = (n + slides.length) % slides.length;
    slides[current].classList.add('is-active');
    dots[current].classList.add('is-active');

    /* Load video fresh when entering video slide — triggers autoplay reliably */
    var entering = slides[current];
    if (entering.classList.contains('lp-slide-video')) {
      var videoSrc = entering.dataset.videoSrc;
      var enteringIframe = entering.querySelector('iframe');
      if (enteringIframe && videoSrc) enteringIframe.src = videoSrc;
    }

    /* Eagerly decode next image slide */
    var nextSlide = slides[(current + 1) % slides.length];
    var nextImg = nextSlide && nextSlide.querySelector('img');
    if (nextImg && nextImg.dataset.src) { nextImg.src = nextImg.dataset.src; delete nextImg.dataset.src; }
  }

  function startTimer() {
    clearInterval(timer);
    timer = setInterval(function () { goTo(current + 1); }, DURATIONS[current]);
  }

  dots.forEach(function (dot) {
    dot.addEventListener('click', function () {
      goTo(parseInt(dot.dataset.index));
      startTimer();
    });
  });

  startTimer();

  /* ── Gallery lightbox ── */
  var GALLERY_FULL = [
    {% for photo in gallery %}"{{ photo.full }}"{% if not loop.last %},{% endif %}
    {% endfor %}
  ];

  var ALL_PHOTOS = [];
  {% if photos_slug and photo_count %}
  for (var i = 1; i <= {{ photo_count }}; i++) {
    var n = i < 10 ? '0' + i : '' + i;
    ALL_PHOTOS.push('/assets/images/properties/{{ photos_slug }}/full/' + n + '.webp');
  }
  {% endif %}

  var lb        = document.getElementById('lp-lightbox');
  var lbImg     = document.getElementById('lp-lb-img');
  var lbCounter = document.getElementById('lp-lb-counter');
  var activeSet = GALLERY_FULL;
  var idx = 0;

  function showLb(i) {
    idx = ((i % activeSet.length) + activeSet.length) % activeSet.length;
    lbImg.src = activeSet[idx];
    lbCounter.textContent = (idx + 1) + ' / ' + activeSet.length;
    lb.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  document.querySelectorAll('#lp .lp-gal-cell').forEach(function (cell) {
    cell.addEventListener('click', function () {
      activeSet = GALLERY_FULL;
      showLb(parseInt(cell.dataset.lightboxIndex));
    });
  });

  var viewAll = document.getElementById('lp-view-all');
  if (viewAll) {
    viewAll.addEventListener('click', function (e) {
      e.preventDefault();
      activeSet = ALL_PHOTOS;
      showLb(0);
    });
  }

  function closeLb() { lb.classList.remove('open'); document.body.style.overflow = ''; }
  document.getElementById('lp-lb-close').onclick = closeLb;
  document.getElementById('lp-lb-next').onclick = function (e) { e.stopPropagation(); showLb(idx + 1); };
  document.getElementById('lp-lb-prev').onclick = function (e) { e.stopPropagation(); showLb(idx - 1); };
  lb.addEventListener('click', function (e) { if (e.target === lb) closeLb(); });
  document.addEventListener('keydown', function (e) {
    if (!lb.classList.contains('open')) return;
    if (e.key === 'Escape')     closeLb();
    if (e.key === 'ArrowRight') showLb(idx + 1);
    if (e.key === 'ArrowLeft')  showLb(idx - 1);
  });

})();
</script>
