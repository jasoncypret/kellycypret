    <div class="lp-section-head">
      <span class="lp-eyebrow center">Gallery</span>
      <h2 class="lp-h2">{{ gallery_title or "Tour the Home" }}</h2>
      {% if gallery_desc %}
      <p class="lp-desc">{{ gallery_desc }}</p>
      {% endif %}
    </div>
    <div class="lp-gallery-grid">
      {% for photo in gallery %}
      <div class="lp-gal-cell {{ photo.cls }}" data-lightbox-index="{{ loop.index0 }}">
        <img src="{{ photo.src }}" alt="{{ photo.caption }}" loading="lazy">
        <span class="lp-gal-caption">{{ photo.caption }}</span>
        <button class="lp-gal-expand" aria-label="Expand photo"><span class="fa fa-expand"></span></button>
      </div>
      {% endfor %}
    </div>
    <p class="lp-gallery-hint">
      Click any photo to view full-screen &nbsp;·&nbsp;
      {% if photos_slug and photo_count %}
      <a href="#" id="lp-view-all">View all {{ photo_count }} photos</a>
      {% endif %}
    </p>
  </div>
</section>

