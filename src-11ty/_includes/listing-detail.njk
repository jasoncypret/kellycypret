          <span class="lp-spec-pill"><span class="fa fa-bed"></span><strong>{{ beds }} Beds</strong></span>
          <span class="lp-spec-div"></span>
          <span class="lp-spec-pill"><span class="fa fa-bath"></span><strong>{{ baths }} Baths</strong></span>
          <span class="lp-spec-div"></span>
          <span class="lp-spec-pill"><span class="fa fa-arrows-alt"></span><strong>{{ sqft }} Sq Ft</strong></span>
          <span class="lp-spec-div"></span>
          <span class="lp-spec-pill"><span class="fa fa-tree"></span><strong>{{ lot }} Acre</strong></span>
        </div>
      </div>
      <div class="lp-info-right">
        <div class="lp-price">{{ price }}</div>
