    <div class="lp-reel-text">
      <span class="lp-eyebrow on-dark" style="margin-bottom:16px;">Video Walkthrough</span>
      <h2 class="lp-h2 on-dark" style="font-size:clamp(28px,3.2vw,44px);margin:0 0 20px;">
        {{ reel_title or "Walk through every room." }}
      </h2>
      {% if reel_desc %}
      <p style="font-family:var(--lp-sans);font-size:16.5px;line-height:1.82;color:rgba(255,255,255,.72);margin:0 0 34px;">
        {{ reel_desc }}
      </p>
      {% endif %}
      <ul class="lp-reel-feature-list">
        {% for feat in reel_features %}
        <li class="lp-reel-feature">
          <span class="lp-reel-icon"><span class="fa fa-{{ feat.icon }}"></span></span>
          {{ feat.label }}
        </li>
        {% endfor %}
      </ul>
      <div style="display:flex;gap:12px;flex-wrap:wrap;">
        <a class="lp-btn lp-btn-cream" href="tel:{{ phone_dial }}"><span class="fa fa-phone"></span> Call Kelly</a>
